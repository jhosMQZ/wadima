# Copie a .env (nunca se versiona). `python manage.py db init` rellena las variables de base de datos.
WADIMA_ENV=development
# wadima = propietario de las tablas (migraciones, copias); wadima_app = la aplicación (sin propiedad).
WADIMA_DB_PASSWORD=
WADIMA_APP_DB_PASSWORD=
WADIMA_DATABASE_URL=postgresql+psycopg://wadima_app:CAMBIAR@127.0.0.1:5433/wadima
WADIMA_MIGRATION_DATABASE_URL=postgresql+psycopg://wadima:CAMBIAR@127.0.0.1:5433/wadima
WADIMA_TEST_DATABASE_URL=postgresql+psycopg://wadima:CAMBIAR@127.0.0.1:5433/wadima_test
WADIMA_TEST_APP_DATABASE_URL=postgresql+psycopg://wadima_app:CAMBIAR@127.0.0.1:5433/wadima_test
WADIMA_E2E_DATABASE_URL=postgresql+psycopg://wadima:CAMBIAR@127.0.0.1:5433/wadima_e2e
WADIMA_E2E_APP_DATABASE_URL=postgresql+psycopg://wadima_app:CAMBIAR@127.0.0.1:5433/wadima_e2e

# Red (por defecto solo este equipo). Para socios remotos use la IP de una VPN privada.
WADIMA_BIND_HOST=127.0.0.1
WADIMA_PUBLIC_ORIGIN=http://127.0.0.1:8000
WADIMA_PREVIEW_PUBLIC_ORIGIN=http://127.0.0.1:8001
# WADIMA_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://127.0.0.1:5173"]
# WADIMA_COOKIE_SECURE=true   # solo con HTTPS
# HTTPS directo en la red privada (el micrófono de las reuniones lo exige fuera de localhost).
# `python manage.py tls <ip-o-nombre>` genera los certificados y rellena estas variables y los orígenes.
# WADIMA_TLS_CERT_FILE=
# WADIMA_TLS_KEY_FILE=

# Reuniones (WebRTC). Vacío = conexión directa entre navegadores (misma LAN o VPN como Tailscale).
# WADIMA_ICE_SERVERS=[{"urls": "stun:stun.example.org:3478"}]
# TURN propio (coturn con use-auth-secret): WADIMA genera credenciales temporales por socio.
# WADIMA_TURN_URLS=["turn:turn.example.org:3478?transport=udp"]
# WADIMA_TURN_SECRET=

# Servidor MCP para que cada socio use su suscripción de Claude desde Claude Code (true por defecto).
# WADIMA_MCP_ENABLED=true

# Carpeta de PostgreSQL portátil y sus datos (por defecto %USERPROFILE%\.wadima)
# WADIMA_HOME=

# Límites de Project Studio por ejecución
# WADIMA_RUN_MEMORY_MB=1024
# WADIMA_RUN_CPU_PERCENT=50
# WADIMA_RUN_TIMEOUT_SECONDS=900

# Clave maestra opcional; si se omite se genera y se protege con DPAPI en var/secrets.
# WADIMA_MASTER_KEY=

# Google Drive (cliente OAuth de Google Cloud con la API de Drive habilitada)
WADIMA_GOOGLE_CLIENT_ID=
WADIMA_GOOGLE_CLIENT_SECRET=
WADIMA_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/drive/oauth/callback

# Las API keys de Anthropic NO van aquí: cada socio la introduce en Configuración de IA (se guarda cifrada).
# El nombre comercial, el logotipo, los colores y la zona horaria se configuran en la aplicación
# (Configuración → Identidad de la organización), no aquí.
